[Unit]
Description=Filiolae Unix Ledger witness for %i
Documentation=file:/usr/share/doc/filiolae/unix-witness.md
After=systemd-tmpfiles-setup.service
RequiresMountsFor=/srv/filiolae/runs/%i /var/lib/filiolae-witness
ConditionPathExists=/run/filiolae-locks/%i/ledger.lock
ConditionPathExists=/var/lib/filiolae-witness/%i/enrollment.json

[Service]
Type=exec
User=filiolae-witness
Group=filiolae-witness
SupplementaryGroups=filiolae-ledger
Slice=filiolae-governed.slice
EnvironmentFile=/etc/filiolae-witness/runs/%i.env
ExecStart=/usr/bin/env filiolae anchor-witness-serve /srv/filiolae/runs/%i/control/filiolae/ledger.jsonl --artifact-root /srv/filiolae/runs/%i/control/filiolae/artifacts --ledger-lock /run/filiolae-locks/%i/ledger.lock --socket /run/filiolae-witness/%i.sock --socket-mode 0660 --socket-gid ${FILIOLAE_LEDGER_SHARED_GID} --anchor-dir /var/lib/filiolae-witness/%i --private-key /etc/filiolae-witness/ed25519-private.pem --enrollment /var/lib/filiolae-witness/%i/enrollment.json --allowed-uid ${FILIOLAE_ORCHESTRATOR_UID} --connection-timeout 10
ExecStartPost=/usr/libexec/filiolae-witness-ready /run/filiolae-witness/%i.sock 10
Restart=no
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/srv/filiolae/runs/%i /etc/filiolae-witness
ReadWritePaths=/var/lib/filiolae-witness /run/filiolae-witness /run/filiolae-locks/%i

[Install]
WantedBy=multi-user.target
